# ============================================
#  api/.env.local — carregado no container da API
#  Copie: cp api/.env.example api/.env.local
# ============================================

# STORAGE
STORAGE_PATH=storage

# EXECUÇÃO STANDALONE (fora do Docker) — via compose vem do .env raiz; descomente:
#
# BANCO DE DADOS
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=capo
# DATABASE_PASSWORD=troque-esta-senha
# DATABASE_NAME=capo
#
# API
# NODE_ENV=development
# PORT=3002
# CORS_ORIGIN=http://localhost:8080
#
# AUTENTICAÇÃO (JWT)
# JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# JWT_EXPIRATION=8h
