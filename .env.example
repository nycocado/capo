# ============================================
#  .env (raiz) — interpolado pelo docker-compose
#  Copie: cp .env.example .env
# ============================================

# REDE / PROXY
NGINX_PORT=8080

# BANCO DE DADOS (MariaDB)
MARIADB_HOST=db
MARIADB_PORT=3306
MARIADB_DATABASE=capo
MARIADB_USER=capo
MARIADB_PASSWORD=troque-esta-senha
MARIADB_ROOT_PASSWORD=troque-esta-senha-root

# API
API_INTERNAL_PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# AUTENTICAÇÃO (JWT)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRATION=8h
